# Project npm/pnpm config. Committed on purpose — it must contain NO secrets.
#
# Auth never belongs here. Locally it comes from ~/.npmrc via `npm login`; in CI
# from a NODE_AUTH_TOKEN secret via actions/setup-node. If you ever find an
# `_authToken=` line in this file, treat that token as compromised and revoke it.

# Publish and install against public npm. Pinning this explicitly means a stray
# user- or machine-level registry setting can't silently redirect a publish.
registry=https://registry.npmjs.org/

# NEVER add a line of the form `@gmhlab:registry=...`. A scope mapping overrides
# publishConfig.registry AND an explicit --registry flag, silently redirecting
# both installs and publishes. A stale mapping to a private registry lived here
# and did exactly that.

# Enforce the `engines.node` field (>=20) instead of warning, so Node 18 and
# below fail the install outright rather than producing confusing build errors.
# This line covers plain `npm`/`npx`; pnpm reads its own `engineStrict: true`
# from pnpm-workspace.yaml, so keep the two in step.
engine-strict=true

# Supply-chain provenance is worth enabling once releases run in CI, but it
# requires OIDC and fails outside a supported CI provider — so it stays off for
# local publishing. Uncomment in the release workflow, not here:
# provenance=true
