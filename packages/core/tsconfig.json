{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    /* DOM only for the mocks' localStorage session. The main entry must not
       touch the DOM — it is meant to run anywhere, server included. */
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
