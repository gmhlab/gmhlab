{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    /* DOM for ProductsProvider's localStorage cart/favorites persistence. */
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
